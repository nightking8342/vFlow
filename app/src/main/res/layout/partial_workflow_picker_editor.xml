<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 标题文案由各 UIProvider 在 createEditor 里按模块覆盖
         （同一个布局服务 A / B 两个模块，标题不能写死） -->
    <TextView
        android:id="@+id/text_picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_workflow_picker_title"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <TextView
        android:id="@+id/text_selected_workflow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_workflow_not_selected"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <Button
        android:id="@+id/button_select_workflow"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/button_select_workflow" />

</LinearLayout>
